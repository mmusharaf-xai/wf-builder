# Go workflow-builder backend (required for all API / server-action data)
# Browser + server both use this; no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional server-only override (falls back to NEXT_PUBLIC_API_URL)
# API_URL=http://localhost:8080

# --- Legacy Next.js API / Prisma (unused when using the Go backend) ---
# STORAGE=IN_MEMORY
# PG_DB_URL="postgresql://user:pass@localhost:5432/workflow_builder"
