# Local PostgreSQL connection string (required)
# Defaults assume: user=postgres password=postgres host=localhost port=5432
# Create the database: createdb workflow_builder
PG_DB_URL=postgresql://postgres:postgres@localhost:5432/workflow_builder?sslmode=disable

# HTTP port
PORT=8080

# Comma-separated allowed CORS origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Temporary hard-coded user (matches Next.js app)
DEFAULT_USER_ID=1

# Path to migrations directory (defaults to ./migrations)
MIGRATIONS_DIR=migrations
